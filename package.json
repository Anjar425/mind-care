{
	"name": "mind-care",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"packageManager": "pnpm@10.22.0",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"prebuild": "prisma generate",
		"build": "nest build",
		"build:seed": "tsc --project tsconfig.reference-seed.json",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --fix",
		"lint:check": "eslint \"{src,test,scripts}/**/*.ts\"",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --testPathPatterns \"test/.*\\.e2e-spec\\.ts$\"",
		"test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-db.config.cjs --runInBand",
		"db:migrate": "prisma migrate deploy",
		"db:drift": "prisma migrate diff --from-migrations src/prisma/migrations --to-schema src/prisma --exit-code",
		"seed:references": "pnpm build:seed && node dist/reference-seed/scripts/seed-reference-data.js",
		"openapi:generate": "node scripts/generate-openapi.cjs",
		"openapi:check": "pnpm build && pnpm openapi:generate && git diff --exit-code -- docs/openapi.json"
	},
	"dependencies": {
		"@nestjs/common": "^11.2.8",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.2.8",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.2.8",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "^11.4.8",
		"@nestjs/terminus": "^11.1.1",
		"@nestjs/throttler": "^6.7.1",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dotenv": "^17.4.2",
		"helmet": "^8.3.0",
		"nodemailer": "^10.4.0",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.5",
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.2.8",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.19.2",
		"@types/supertest": "^7.2.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.14.0",
		"jest": "^30.5.2",
		"prettier": "^3.9.10",
		"prisma": "^7.10.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.2",
		"ts-jest": "^29.4.15",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1"
	},
	"pnpm": {
		"overrides": {
			"multer": "^2.5.0",
			"glob@>=9.0.0 <14.0.2": "^14.0.2",
			"minimatch@>=7.0.0 <11.0.1": "^11.0.1"
		},
		"onlyBuiltDependencies": [
			"@prisma/engines",
			"prisma"
		],
		"patchedDependencies": {
			"deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
		},
		"auditConfig": {
			"ignoreGhsas": [
				"GHSA-gcqx-w48m-w2h4"
			]
		}
	}
}
