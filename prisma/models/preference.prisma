model Preferences {
    id                Int  @id @default(autoincrement())
    percentAnxiety    Int
    percentDepression Int
    percentStress     Int
    catalogVersion    String

    dass21Id String
    dass21   DASS21 @relation(fields: [dass21Id], references: [id])

    expertId String
    expert Expert @relation(fields: [expertId], references: [id])

    @@unique([expertId, dass21Id])
}
