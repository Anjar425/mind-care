model Rule {
    id             Int       @id @default(autoincrement())
    groupId        Int
    authorExpertId String
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @default(now())
    archivedAt     DateTime?
    group          Group     @relation(fields: [groupId], references: [id], onDelete: Restrict)
    author         Expert    @relation(fields: [authorExpertId], references: [id], onDelete: Restrict)
    revisions      RuleRevision[]
    audits         RuleAudit[]
    conflictMembers RuleConflictMember[]
    resolutionActions RuleResolutionAction[]

    @@index([groupId, updatedAt, id])
    @@index([authorExpertId, updatedAt, id])
}
