enum CredentialType {
    STR
    SIP
}

enum CredentialStatus {
    PENDING
    APPROVED
    REJECTED
    SUPERSEDED
}

model CredentialIdentity {
    id        String               @id @default(uuid())
    type      CredentialType
    lookup    String
    expertId  String
    expert    Expert               @relation(fields: [expertId], references: [id])
    revisions CredentialRevision[]

    @@unique([type, lookup])
}

model CredentialRevision {
    id                 String              @id @default(uuid())
    expertId           String
    expert             Expert              @relation(fields: [expertId], references: [id])
    identityId         String
    identity           CredentialIdentity  @relation(fields: [identityId], references: [id])
    type               CredentialType
    status             CredentialStatus    @default(PENDING)
    numberCipher       String
    holderName         String
    expiresAt          DateTime
    expiryDate         String
    objectKey          String              @unique
    digest             String
    mime               String
    size               Int
    submittedAt        DateTime            @default(now())
    reviewedAt         DateTime?
    reviewerId         String?
    reviewer           User?               @relation("CredentialReviewer", fields: [reviewerId], references: [id])
    reason             String?
    purgeAfter         DateTime?
    purgedAt           DateTime?
    issuerVerification String              @default("NOT_CHECKED")
    audits             CredentialAudit[]
    reminder           CredentialReminder?

    @@index([expertId, type, status])
    @@index([status, expiresAt])
    @@index([purgeAfter, purgedAt])
}

model CredentialAudit {
    id         String              @id @default(uuid())
    expertId   String
    expert     Expert              @relation(fields: [expertId], references: [id])
    revisionId String?
    revision   CredentialRevision? @relation(fields: [revisionId], references: [id])
    actorId    String
    actor      User                @relation("CredentialActor", fields: [actorId], references: [id])
    action     String
    reason     String
    createdAt  DateTime            @default(now())

    @@index([expertId, createdAt])
}

model CredentialReminder {
    id          String             @id @default(uuid())
    revisionId  String             @unique
    revision    CredentialRevision @relation(fields: [revisionId], references: [id])
    attempts    Int                @default(0)
    leaseUntil  DateTime?
    deliveredAt DateTime?
    lastFailure String?
}
