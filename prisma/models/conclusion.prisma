enum CATEGORY {
  DEPRESSION
  ANXIETY
  STRESS
}

enum SEVERITY {
  NORMAL
  MILD
  MODERATE
  SEVERE
  EXTREMELY_SEVERE
}

model Conclusion {
  id       Int      @id @default(autoincrement())
  category CATEGORY
  severity SEVERITY

  ruleRevisions RuleRevision[]

  @@unique([category, severity])
}
