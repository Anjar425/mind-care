# MindCare backend environment template.
# Copy to .env for local development. Values below are FORMAT PLACEHOLDERS, not secrets.
# Validation lives in src/infrastructure/config/environment.config.ts; startup fails and names
# (never prints) any invalid key. Keys marked "default" may be omitted.

# --- Runtime ---------------------------------------------------------------
# development | test | production   (production requires https FRONTEND_URL/CORS origins,
# turns on HSTS and a strict CSP, and switches Swagger off by default)
NODE_ENV=development
# default 3000
PORT=3000

# --- Database (PostgreSQL) -------------------------------------------------
# Pool size 1-50 (default 10) and per-statement / idle-in-transaction timeout in ms,
# 1000-60000 (default 15000). Both may be omitted.
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000
# With `docker compose up -d postgres`: postgresql://mindcare:mindcare@127.0.0.1:5432/mindcare
# (prefer 127.0.0.1; on some Windows setups localhost resolves to IPv6 ::1, which Docker does not forward)
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/mindcare

# --- Development and tests only (optional, never used by the running app) ---
# Disposable database for `pnpm test:db`. It is DROPPED AND RECREATED on every run;
# the name must end in "_test". Compose creates it on first start.
DB_TEST_DATABASE_URL=postgresql://mindcare:mindcare@127.0.0.1:5432/mindcare_test
# Empty shadow database for `pnpm db:drift` (schema vs migrations check).
SHADOW_DATABASE_URL=postgresql://mindcare:mindcare@127.0.0.1:5432/mindcare_shadow

# --- Auth ------------------------------------------------------------------
# Each at least 32 bytes; the refresh secret must differ from the access secret.
JWT_ACCESS_SECRET=<random-string-of-at-least-32-bytes>
JWT_REFRESH_SECRET=<different-random-string-of-at-least-32-bytes>
# default 15 each
VERIFICATION_TOKEN_EXPIRY_MINUTES=15
RESET_TOKEN_EXPIRY_MINUTES=15
# Access token lifetime in seconds, 300-3600, default 900 (15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh session lifetime in days, 1-30, default 7
SESSION_TTL_DAYS=7

# --- Frontend ----------------------------------------------------------------
# Public base URL of the WEB FRONTEND (not this API). Email links are built from it:
#   <FRONTEND_URL>/auth/verify?token=...          -> frontend page that calls GET  /api/v1/auth/verify
#   <FRONTEND_URL>/auth/reset-password?token=...  -> frontend form that calls POST /api/v1/auth/reset-password
# The frontend must serve both routes. No credentials, query or hash; trailing slash is removed.
FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call this API: comma-separated scheme://host[:port], no path.
# Default: the FRONTEND_URL origin outside production; none in production (same-origin
# deployment behind one reverse proxy). An empty value switches CORS off.
CORS_ORIGIN=http://localhost:5173

# --- HTTP edge -------------------------------------------------------------
# Reverse proxies in front of the API whose X-Forwarded-For is trusted, 0-3, default 0.
# Set 1 behind a single TLS-terminating proxy; rate limits then use the real client IP.
TRUST_PROXY_HOPS=0
# public | off. Default: public outside production, off in production.
SWAGGER_MODE=public

# --- Mail (SMTP) -----------------------------------------------------------
MAIL_HOST=smtp.example.test
# default 587
MAIL_PORT=587
# true | false, default false
MAIL_SECURE=false
MAIL_USER=<smtp-user>
MAIL_PASS=<smtp-password>
MAIL_FROM=MindCare <no-reply@example.test>

# --- Rate limiting (no defaults unless noted) ------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL=120
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_FORGOT_PASSWORD=3
RATE_LIMIT_SEND_VERIFICATION=3
RATE_LIMIT_REFRESH=30
# default 10
RATE_LIMIT_SCREENING_QDSS=10
# default 5
RATE_LIMIT_SCREENING_DASS42=5

# --- Health ----------------------------------------------------------------
HEALTH_CHECK_TIMEOUT_MS=1000

# --- Expert credential documents -------------------------------------------
# Must be .private/<name>; the folder is git-ignored and must never be served.
CREDENTIAL_STORAGE_ROOT=.private/credentials
# 64 hex characters each; the two keys must differ.
CREDENTIAL_ENCRYPTION_KEY=<64-hex-characters>
CREDENTIAL_LOOKUP_KEY=<different-64-hex-characters>
# default and maximum 5242880 (5 MiB)
CREDENTIAL_UPLOAD_MAX_BYTES=5242880
# default 3, maximum 120
CREDENTIAL_UPLOAD_RATE_LIMIT=3
# default and maximum 30
CREDENTIAL_REMINDER_LEAD_DAYS=30
# Asia/Jakarta hour 1-23 (0 is rejected by validation), default 9
CREDENTIAL_REMINDER_HOUR=9
