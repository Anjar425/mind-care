enum ROLE {
  ADMIN
  EXPERT
  USER
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  role              ROLE
  email_verified_at DateTime?
  created_at        DateTime  @default(now())

  expert                    Expert?
  refreshTokens             RefreshToken[]
  emailVerificationTokens   EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
}
