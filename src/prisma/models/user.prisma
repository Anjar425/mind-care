enum ROLE {
    ADMIN
    EXPERT
    USER
}

model User {
    qdssDatasets QdssDataset[]
    qdssRuns QdssRun[]
    qdssAudits QdssAudit[]
    id                String    @id @default(uuid())
    name              String
    email             String    @unique
    password          String
    role              ROLE
    email_verified_at DateTime?
    created_at        DateTime  @default(now())

    expert                  Expert?
    refreshTokens           RefreshToken[]
    emailVerificationTokens EmailVerificationToken[]
    passwordResetTokens     PasswordResetToken[]
    credentialReviews       CredentialRevision[]     @relation("CredentialReviewer")
    credentialActions       CredentialAudit[]        @relation("CredentialActor")
    groupInvitations        GroupInvitation[]        @relation("GroupInviteRecipient")
    sentGroupInvitations    GroupInvitation[]        @relation("GroupInviteActor")
    groupActions            GroupAudit[]             @relation("GroupAuditActor")
    ruleActions             RuleAudit[]
    ruleProposals RuleResolutionProposal[]
    ruleParticipants RuleResolutionParticipant[]
    ruleDecisions RuleResolutionDecision[]
    conflictNotifications RuleConflictNotification[]
    conflictAudits RuleConflictAudit[]
}
