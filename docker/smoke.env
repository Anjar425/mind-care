# Synthetic, NON-SECRET values for the CI container smoke test only.
# Copied to .env by the CI "image" job; never use these values anywhere real.
NODE_ENV=development
PORT=3000
JWT_ACCESS_SECRET=smoke-test-access-secret-0000000000000
JWT_REFRESH_SECRET=smoke-test-refresh-secret-000000000000
VERIFICATION_TOKEN_EXPIRY_MINUTES=15
RESET_TOKEN_EXPIRY_MINUTES=15
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
MAIL_USER=smoke
MAIL_PASS=smoke
MAIL_FROM=MindCare Smoke <smoke@example.invalid>
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL=120
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_FORGOT_PASSWORD=3
RATE_LIMIT_SEND_VERIFICATION=3
RATE_LIMIT_REFRESH=30
HEALTH_CHECK_TIMEOUT_MS=1000
CREDENTIAL_STORAGE_ROOT=.private/credentials
CREDENTIAL_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
CREDENTIAL_LOOKUP_KEY=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
